{
  "name": "Psikorehber (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Bağımlılıklar kuruldu'",
  // Not: Eski sürüm CORS ve XSRF korumasını kapatıyordu (--server.enableCORS false
  // --server.enableXsrfProtection false). Bu, başka sitelerin uygulamaya istek atabilmesine yol açar;
  // Codespaces önizlemesi için gerekli değil, kaldırıldı.
  "postAttachCommand": {
    "server": "streamlit run app.py"
  },
  "portsAttributes": {
    "8501": { "label": "Psikorehber", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
