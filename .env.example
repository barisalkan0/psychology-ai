# Bu dosyayı .env olarak kopyala ve doldur:  cp .env.example .env
# .env dosyası .gitignore'da; asla commit'leme.

# Google AI Studio'dan alınan anahtar. Boş bırakılırsa uygulama demo modunda (sabit cevaplarla) açılır.
GEMINI_API_KEY=

# Model adı. "latest" takma adı Google eski modelleri kapattığında uygulamanın 404 ile çökmesini önler;
# üretimde sabit bir sürüm adı (ör. ai.google.dev/gemini-api/docs/models listesinden) yazman önerilir.
GEMINI_MODEL=gemini-flash-latest

# Ücretli kota kullanıyorsan true yap. Ücretsiz kotada Google içerikleri ürün geliştirmede kullanabilir
# ve insan değerlendiriciler okuyabilir; rıza ekranındaki uyarı buna göre değişir.
GEMINI_PAID_TIER=false

# KVKK aydınlatma metninde görünecek veri sorumlusu bilgisi
VERI_SORUMLUSU=Psycalm geliştiricisi
VERI_SORUMLUSU_ILETISIM=ornek@eposta.com

# İsteğe bağlı
# PSYCALM_DB=data/psycalm.db
# PSYCALM_MOCK=1   # anahtar olsa bile demo modunu zorla
